{
  "info": {
    "name": "Todo App API",
    "description": "Postman collection for the Auth and Todos modules.\n\nRegister and Login store the access token in {{accessToken}}; every other request inherits it as a Bearer token.\n\nThe refresh token is an httpOnly cookie (Path=/auth), so it is never stored in a variable - Postman replays the cookie for /auth/refresh.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "todoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "email",
      "value": "user@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Passw0rd!",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates a user. Responds 409 if the email is already taken.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 or 409 (already registered)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set(\"userId\", body.data.id);",
                  "    pm.test(\"Password is not returned\", function () {",
                  "        pm.expect(body.data).to.not.have.property(\"password\");",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Returns the access token in the body. The refresh token is set as an httpOnly cookie (refreshToken, Path=/auth) and is NOT in the body.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"accessToken\", body.data.accessToken);",
                  "pm.collectionVariables.set(\"userId\", body.data.user.id);",
                  "",
                  "pm.test(\"Access token returned\", function () {",
                  "    pm.expect(body.data.accessToken).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Refresh token is set as a cookie, not in the body\", function () {",
                  "    pm.expect(body.data).to.not.have.property(\"refreshToken\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "No request body. Reads the refreshToken cookie set by Login. The cookie is scoped to /auth, so Postman sends it automatically.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"accessToken\", body.accessToken);",
                  "",
                  "pm.test(\"New access token returned\", function () {",
                  "    pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (Profile)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Requires a Bearer access token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns the current user\", function () {",
                  "    pm.expect(body.data).to.have.property(\"email\");",
                  "    pm.expect(body.data).to.not.have.property(\"password\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Clears the refresh-token cookie. Does not require an access token.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Todos",
      "item": [
        {
          "name": "List Todos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos?page=1&limit=10&sortBy=createdAt&sortOrder=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "sortBy",
                  "value": "createdAt"
                },
                {
                  "key": "sortOrder",
                  "value": "desc"
                },
                {
                  "key": "priority",
                  "value": "HIGH",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "swagger",
                  "disabled": true
                }
              ]
            },
            "description": "Returns only the authenticated user's todos.\n\nQuery params: page, limit (1-100), priority (HIGH|MEDIUM|LOW), search (case-insensitive title match), sortBy (createdAt|updatedAt|title|priority), sortOrder (asc|desc)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns data and meta\", function () {",
                  "    pm.expect(body.data).to.be.an(\"array\");",
                  "    pm.expect(body.meta).to.have.all.keys(\"total\", \"page\", \"limit\", \"totalPages\");",
                  "});",
                  "",
                  "pm.test(\"Respects the limit\", function () {",
                  "    pm.expect(body.data.length).to.be.at.most(body.meta.limit);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Todos - filtered",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos?priority=HIGH&search=swagger&sortBy=title&sortOrder=asc&page=1&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos"
              ],
              "query": [
                {
                  "key": "priority",
                  "value": "HIGH"
                },
                {
                  "key": "search",
                  "value": "swagger"
                },
                {
                  "key": "sortBy",
                  "value": "title"
                },
                {
                  "key": "sortOrder",
                  "value": "asc"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Same endpoint with every filter applied at once."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Every result matches the priority filter\", function () {",
                  "    body.data.forEach(function (t) {",
                  "        pm.expect(t.priority).to.eql(\"HIGH\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Sorted by title ascending\", function () {",
                  "    const titles = body.data.map(function (t) { return t.title; });",
                  "    pm.expect(titles).to.eql(titles.slice().sort());",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Todo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/todos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos"
              ]
            },
            "description": "Responds 409 if this user already has a todo with the same title.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Write the Swagger documentation\",\n  \"priority\": \"HIGH\",\n  \"completed\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"todoId\", body.data.id);",
                  "",
                  "pm.test(\"Todo is owned by the current user\", function () {",
                  "    pm.expect(body.data.userId).to.eql(pm.collectionVariables.get(\"userId\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Todo By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos/{{todoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "{{todoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns the requested todo\", function () {",
                  "    pm.expect(body.data.id).to.eql(pm.collectionVariables.get(\"todoId\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Todo",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/todos/{{todoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "{{todoId}}"
              ]
            },
            "description": "At least one of title or priority is required, otherwise 400.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated title\",\n  \"priority\": \"MEDIUM\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Fields were updated\", function () {",
                  "    pm.expect(body.data.title).to.eql(\"Updated title\");",
                  "    pm.expect(body.data.priority).to.eql(\"MEDIUM\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Toggle Todo",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos/{{todoId}}/toggle",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "{{todoId}}",
                "toggle"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Completed is a boolean\", function () {",
                  "    pm.expect(body.data.completed).to.be.a(\"boolean\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Todo",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos/{{todoId}}/delete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "{{todoId}}",
                "delete"
              ]
            },
            "description": "Note the non-standard /delete suffix. DELETE /todos/{id} is not routed and responds 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns the deleted todo\", function () {",
                  "    pm.expect(body.data.id).to.eql(pm.collectionVariables.get(\"todoId\"));",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"todoId\", \"\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Completed Todos",
          "request": {
            "method": "DELETE",
            "header": [],
            "description": "Bulk-deletes every completed todo for the current user. Always 200; count is 0 when nothing matched.\n\nThe response is double-wrapped: the service returns {message, data} and the controller wraps that again, so the count is at data.data.count.",
            "url": {
              "raw": "{{baseUrl}}/todos/delete/completed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "delete",
                "completed"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns a deletion count\", function () {",
                  "    pm.expect(body.data.data.count).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Error cases",
      "description": "Negative tests covering auth, ownership and validation.",
      "item": [
        {
          "name": "Todos without a token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown todo -> 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos/00000000-0000-4000-8000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "00000000-0000-4000-8000-000000000000"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete on the standard path -> 404 (route not defined)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos/{{todoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "{{todoId}}"
              ]
            },
            "description": "Demonstrates that the delete route requires the /delete suffix."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update with an empty body -> 400",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/todos/{{todoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "{{todoId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid priority -> 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos?priority=URGENT",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos"
              ],
              "query": [
                {
                  "key": "priority",
                  "value": "URGENT"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Bulk delete without a token -> 401",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/todos/delete/completed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "todos",
                "delete",
                "completed"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
